# Copy to .env for local dev:  cp .env.example .env

# Postgres — matches docker-compose host port 5433
DATABASE_URL=postgres://chat:chat_dev@localhost:5433/chat?sslmode=disable

# Redis — matches docker-compose host port 6381
REDIS_ADDR=localhost:6381

# Auth — CHANGE in any non-local environment
JWT_SECRET=dev-change-me

# HTTP gateway listen address
HTTP_ADDR=:8080

# Ollama (local LLM) — used from Phase 3 (embeddings) onward
OLLAMA_URL=http://localhost:11434
